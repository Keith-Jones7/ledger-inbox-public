# Python commands read exported environment variables. Compose reads this file.
LEDGER_INBOX_DATA_DIR=data
LEDGER_INBOX_MAX_IMAGE_BYTES=12582912
LEDGER_INBOX_MAX_EMAIL_BYTES=50331648
LEDGER_INBOX_MAX_IMAGE_PIXELS=25000000
LEDGER_INBOX_MIN_CONFIDENCE=0.9
LEDGER_INBOX_REQUIRED_FIELDS=occurred_at,category
# LEDGER_INBOX_CATEGORIES=food,shopping,transport,other,income,refund
LEDGER_INBOX_LEASE_SECONDS=600
LEDGER_INBOX_MAX_RECOGNITION_ATTEMPTS=3

# Safe default: review every image through API/CLI before delivery.
LEDGER_INBOX_RECOGNIZER=mock
# LEDGER_INBOX_RECOGNIZER=openai-compatible
# LEDGER_INBOX_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# LEDGER_INBOX_MODEL_API_KEY=local
# LEDGER_INBOX_MODEL_NAME=qwen3.5:4b
# LEDGER_INBOX_MODEL_TIMEOUT_SECONDS=90
# LEDGER_INBOX_SHADOW_MODEL=qwen2.5vl:7b

LEDGER_INBOX_LEDGER_SINK=directory
# LEDGER_INBOX_LEDGER_SINK=webhook
# LEDGER_INBOX_LEDGER_WEBHOOK_URL=https://ledger.example.com/write
# LEDGER_INBOX_LEDGER_WEBHOOK_SECRET=replace-with-a-secret
# LEDGER_INBOX_LEDGER_STATUS_URL=https://ledger.example.com/query

# Enables signed raw-mail ingestion.
# LEDGER_INBOX_EMAIL_WEBHOOK_SECRET=replace-with-a-secret

# Optional dedicated mailbox (Python IMAP command; not a default Compose service).
# LEDGER_INBOX_IMAP_HOST=imap.example.com
# LEDGER_INBOX_IMAP_PORT=993
# LEDGER_INBOX_IMAP_USERNAME=ledger@example.com
# LEDGER_INBOX_IMAP_PASSWORD=app-password
# LEDGER_INBOX_IMAP_MAILBOX=INBOX
